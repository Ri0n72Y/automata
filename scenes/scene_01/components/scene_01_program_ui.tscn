[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/scene_01/scene_01_program_ui.gd" id="1_ui"]
[ext_resource type="Script" path="res://scripts/scene_01/scene_01_program_source_editor.gd" id="2_source_editor"]

[node name="ProgramAuthoring" type="VBoxContainer"]
script = ExtResource("1_ui")
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="ActionRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="SaveButton" type="Button" parent="ActionRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "保存"

[node name="LoadButton" type="Button" parent="ActionRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "读取"

[node name="ExportButton" type="Button" parent="ActionRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "复制"

[node name="RunButton" type="Button" parent="ActionRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "运行"

[node name="SourceTitle" type="Label" parent="."]
layout_mode = 2
text = "源码 · 规范 v2"
theme_override_font_sizes/font_size = 14

[node name="Hint" type="Label" parent="."]
layout_mode = 2
text = "上方操作会把当前车辆命令插入光标所在源码位置；参数可直接在源码中编辑。"
autowrap_mode = 2

[node name="SourceEditor" type="CodeEdit" parent="."]
unique_name_in_owner = true
script = ExtResource("2_source_editor")
custom_minimum_size = Vector2(0, 220)
layout_mode = 2
text = "automata_scene01_program 2\n"
size_flags_horizontal = 3
size_flags_vertical = 3
placeholder_text = "automata_scene01_program 2"
wrap_mode = 1
highlight_current_line = true
gutters_draw_executing_lines = true
gutters_draw_line_numbers = true
gutters_zero_pad_line_numbers = true

[node name="StatusLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "语法有效 · 0 条语句"
autowrap_mode = 2
modulate = Color(0.68, 0.86, 1, 1)

[node name="ProgramToolsDivider" type="HSeparator" parent="."]
layout_mode = 2

[node name="RepeatRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="RepeatLabel" type="Label" parent="RepeatRow"]
layout_mode = 2
text = "重复"

[node name="RepeatCount" type="SpinBox" parent="RepeatRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 1
min_value = 1.0
max_value = 100.0
value = 2.0
prefix = "× "

[node name="RepeatTargetOption" type="OptionButton" parent="RepeatRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
disabled = true

[node name="AddRepeatButton" type="Button" parent="RepeatRow"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "插入"

[node name="ClearButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "全部清空"
