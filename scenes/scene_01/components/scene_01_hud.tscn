theme_override_constants/separation = 8

[node name="Title" type="Label" parent="RootControl/SidebarPanel/Margin/SidebarScroll/Sidebar/GuideSection/Header/Margin/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "操作指南"
theme_override_colors/font_color = Color(0.1, 0.16, 0.23, 1)
theme_override_font_sizes/font_size = 15

[node name="TutorialButton" type="Button" parent="RootControl/SidebarPanel/Margin/SidebarScroll/Sidebar/GuideSection/Header/Margin/HeaderRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "打开教学"

[node name="Card" type="PanelContainer" parent="RootControl/SidebarPanel/Margin/SidebarScroll/Sidebar/GuideSection"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_section_body")

[node name="Margin" type="MarginContainer" parent="RootControl/SidebarPanel/Margin/SidebarScroll/Sidebar/GuideSection/Card"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 7
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 7

[node name="Text" type="Label" parent="RootControl/SidebarPanel/Margin/SidebarScroll/Sidebar/GuideSection/Card/Margin"]
layout_mode = 2
size_flags_horizontal = 3
text = "左键选择车辆 · M 移动 · X 停止\nA / D 旋转 · 机械臂 C 抓放 · Q / E 旋转相机"
autowrap_mode = 2
theme_override_colors/font_color = Color(0.32, 0.37, 0.43, 1)

[node name="CompletionPanel" type="PanelContainer" parent="RootControl"]
unique_name_in_owner = true
visible = false
layout_mode = 0
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -230.0
offset_top = -82.0
offset_right = 230.0
offset_bottom = 82.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="RootControl/CompletionPanel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 18

[node name="VBox" type="VBoxContainer" parent="RootControl/CompletionPanel/Margin"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 8

[node name="CompletionTitle" type="Label" parent="RootControl/CompletionPanel/Margin/VBox"]
layout_mode = 2
text = "任务完成"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(0.06, 0.48, 0.34, 1)

[node name="CompletionSummaryLabel" type="Label" parent="RootControl/CompletionPanel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "标准箱 8/8 · 任务已完成"
horizontal_alignment = 1

[node name="ScorePlaceholder" type="Label" parent="RootControl/CompletionPanel/Margin/VBox"]
layout_mode = 2
text = "时间 —   组件 —   自动化率 —"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.38, 0.43, 0.49, 1)

[node name="ScorePresenter" type="Node" parent="."]
script = ExtResource("3_score_presenter")
