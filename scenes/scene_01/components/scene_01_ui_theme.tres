[resource]
default_font = SubResource("SystemFont_ui")
default_font_size = 14
Label/colors/font_color = Color(0.9, 0.93, 0.97, 1)
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")
Button/colors/font_color = Color(0.9, 0.93, 0.97, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(0.88, 0.96, 1, 1)
Button/colors/font_disabled_color = Color(0.48, 0.53, 0.6, 1)
Button/styles/normal = SubResource("StyleBoxFlat_button")
Button/styles/hover = SubResource("StyleBoxFlat_button_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_button_pressed")
Button/styles/disabled = SubResource("StyleBoxFlat_button_disabled")
