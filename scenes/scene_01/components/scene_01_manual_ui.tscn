[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/scene_01/scene_01_manual_controls.gd" id="1_controls"]
[ext_resource type="Theme" path="res://scenes/scene_01/components/scene_01_ui_theme.tres" id="2_theme"]

[node name="UIRoot" type="CanvasLayer"]
script = ExtResource("1_controls")

[node name="RootControl" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")

[node name="Panel" type="PanelContainer" parent="RootControl"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 16.0
offset_top = 82.0
offset_right = 376.0
offset_bottom = 134.0
mouse_filter = 1

[node name="Margin" type="MarginContainer" parent="RootControl/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="RootControl/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HeaderRow" type="HBoxContainer" parent="RootControl/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="RootControl/Panel/Margin/VBox/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Scene 01 · 操作指南"
theme_override_font_sizes/font_size = 18

[node name="TutorialButton" type="Button" parent="RootControl/Panel/Margin/VBox/HeaderRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "教学"
tooltip_text = "打开 Scene 01 教学"

[node name="CollapseButton" type="Button" parent="RootControl/Panel/Margin/VBox/HeaderRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 30)
layout_mode = 2
focus_mode = 0
text = "▶"

[node name="ManualBody" type="ScrollContainer" parent="RootControl/Panel/Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3

[node name="BodyVBox" type="VBoxContainer" parent="RootControl/Panel/Margin/VBox/ManualBody"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Instructions" type="Label" parent="RootControl/Panel/Margin/VBox/ManualBody/BodyVBox"]
layout_mode = 2
text = "▶/⏸ 播放/暂停 · 倍速 0.5×/1×/2×/4× · ↺ 重置\n左键选择车辆；M 进入移动目标模式，左键确认\nM / Esc / 右键退出目标模式；X 停止车辆任务\n机械臂：A / D 调整朝向，C 抓取或放置\nEsc / 右键取消车辆选择；Q / E 旋转相机"
autowrap_mode = 2

[node name="ScopeNote" type="Label" parent="RootControl/Panel/Margin/VBox/ManualBody/BodyVBox"]
layout_mode = 2
text = "HUD 显示车辆、库存、任务和命令反馈。\n绿色机械臂工作区表示存在可执行交互。\n暂停冻结玩法命令但仍可观察；Debug 位于右上角。"
autowrap_mode = 2
modulate = Color(0.72, 0.8, 0.9, 1)

[connection signal="pressed" from="RootControl/Panel/Margin/VBox/HeaderRow/CollapseButton" to="." method="_on_collapse_pressed"]
