[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/scene_01/scene_01_manual_controls.gd" id="1_controls"]

[node name="UIRoot" type="CanvasLayer"]
script = ExtResource("1_controls")

[node name="RootControl" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="RootControl"]
layout_mode = 0
offset_left = 16.0
offset_top = 16.0
offset_right = 438.0
offset_bottom = 474.0
mouse_filter = 1

[node name="Margin" type="MarginContainer" parent="RootControl/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="RootControl/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="RootControl/Panel/Margin/VBox"]
layout_mode = 2
text = "Scene 01 · Manual MoveTo"
theme_override_font_sizes/font_size = 20

[node name="Instructions" type="Label" parent="RootControl/Panel/Margin/VBox"]
layout_mode = 2
text = "Click vehicle → move mouse: predict target and path\nEnter: execute current prediction · left click keeps compatibility\nGreen footprint/path: reachable · Red footprint/path: invalid or busy\nRight click or Esc: clear selection\nQ: camera clockwise · E: camera counterclockwise\nShift+Q: GridRoot +90° · Shift+E: GridRoot -90°\nF: toggle non-uniform scale · G: toggle offset\nR: reset scene · Home: restore transform"
autowrap_mode = 2

[node name="ScopeNote" type="Label" parent="RootControl/Panel/Margin/VBox"]
layout_mode = 2
text = "Prediction snaps to the nearest footprint center.\n1×1 uses cell centers; 2×2 uses grid-line intersections."
autowrap_mode = 2
modulate = Color(0.72, 0.8, 0.9, 1)

[node name="RotateRow" type="HBoxContainer" parent="RootControl/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RotateLeft" type="Button" parent="RootControl/Panel/Margin/VBox/RotateRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Grid -90°"

[node name="RotateRight" type="Button" parent="RootControl/Panel/Margin/VBox/RotateRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Grid +90°"

[node name="TransformRow" type="HBoxContainer" parent="RootControl/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Scale" type="Button" parent="RootControl/Panel/Margin/VBox/TransformRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Toggle Scale"

[node name="Offset" type="Button" parent="RootControl/Panel/Margin/VBox/TransformRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Toggle Offset"

[node name="ResetRow" type="HBoxContainer" parent="RootControl/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Reset" type="Button" parent="RootControl/Panel/Margin/VBox/ResetRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Reset State"

[node name="Restore" type="Button" parent="RootControl/Panel/Margin/VBox/ResetRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Restore Grid"

[node name="StatusLabel" type="Label" parent="RootControl/Panel/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Hover prediction ready"
modulate = Color(0.55, 0.88, 0.72, 1)

[connection signal="pressed" from="RootControl/Panel/Margin/VBox/RotateRow/RotateLeft" to="." method="_on_rotate_left_pressed"]
[connection signal="pressed" from="RootControl/Panel/Margin/VBox/RotateRow/RotateRight" to="." method="_on_rotate_right_pressed"]
[connection signal="pressed" from="RootControl/Panel/Margin/VBox/TransformRow/Scale" to="." method="_on_scale_pressed"]
[connection signal="pressed" from="RootControl/Panel/Margin/VBox/TransformRow/Offset" to="." method="_on_offset_pressed"]
[connection signal="pressed" from="RootControl/Panel/Margin/VBox/ResetRow/Reset" to="." method="_on_reset_pressed"]
[connection signal="pressed" from="RootControl/Panel/Margin/VBox/ResetRow/Restore" to="." method="_on_restore_pressed"]