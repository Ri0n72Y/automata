[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/scene_01/scene_01_manual_controls.gd" id="1_controls"]
[ext_resource type="Theme" path="res://scenes/scene_01/components/scene_01_ui_theme.tres" id="2_theme"]

[node name="UIRoot" type="CanvasLayer"]
script = ExtResource("1_controls")

[node name="RootControl" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")

[node name="Panel" type="PanelContainer" parent="RootControl"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 16.0
offset_top = 16.0
offset_right = 322.0
offset_bottom = 68.0
mouse_filter = 1

[node name="Margin" type="MarginContainer" parent="RootControl/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="RootControl/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="HeaderRow" type="HBoxContainer" parent="RootControl/Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="RootControl/Panel/Margin/VBox/HeaderRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Scene 01 · 操作指南"
theme_override_font_sizes/font_size = 18

[node name="CollapseButton" type="Button" parent="RootControl/Panel/Margin/VBox/HeaderRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(36, 30)
layout_mode = 2
focus_mode = 0
text = "▶"

[node name="Instructions" type="Label" parent="RootControl/Panel/Margin/VBox"]
visible = false
layout_mode = 2
text = "顶部控制：▶/⏸ 播放或暂停，倍速按钮循环 0.5× / 1× / 2× / 4×，↺ 重置\n选择车辆：鼠标左键点击车辆\n移动车辆：按 M 进入目标模式，移动鼠标预览路径，左键确认\n退出移动模式：再次按 M，或按 Esc / 鼠标右键\n机械臂：A / D 调整朝向，C 抓取或放置\n停止车辆任务：X\n取消车辆选择：退出移动模式后按 Esc / 鼠标右键\n旋转相机：Q / E"
autowrap_mode = 2

[node name="ScopeNote" type="Label" parent="RootControl/Panel/Margin/VBox"]
visible = false
layout_mode = 2
text = "暂停时车辆运动、场景计时和 M/X/A/D/C 玩法命令被冻结，相机仍可观察。\n机械臂前方紧邻的两格都是工作区。\n绿色工作区表示当前存在可执行交互；红色表示当前不可执行。\n移动目标模式开启时，A / D / C 和机械臂工作区预览暂时停用。\n调试功能和场地坐标开关位于右上角独立 Debug 面板。"
autowrap_mode = 2
modulate = Color(0.72, 0.8, 0.9, 1)

[node name="StatusLabel" type="Label" parent="RootControl/Panel/Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "点击顶部 ▶ 开始；选择车辆后按 M 移动，机械臂可用 A/D 转向、C 抓取或放置"
autowrap_mode = 2
modulate = Color(0.55, 0.88, 0.72, 1)

[connection signal="pressed" from="RootControl/Panel/Margin/VBox/HeaderRow/CollapseButton" to="." method="_on_collapse_pressed"]
